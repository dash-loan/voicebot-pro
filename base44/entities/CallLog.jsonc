{
  "name": "CallLog",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "title": "\u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "campaign_id": {
      "type": "string",
      "title": "\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "client_id": {
      "type": "string",
      "title": "\u05dc\u05e7\u05d5\u05d7"
    },
    "contact_name": {
      "type": "string",
      "title": "\u05e9\u05dd"
    },
    "contact_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "campaign_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "start_time": {
      "type": "string",
      "title": "\u05d6\u05de\u05df \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_time": {
      "type": "string",
      "title": "\u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd"
    },
    "duration": {
      "type": "number",
      "title": "\u05de\u05e9\u05da (\u05e9\u05e0\u05d9\u05d5\u05ea)",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "voicemail",
        "no_answer",
        "interested",
        "not_interested"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "transcript": {
      "type": "string",
      "title": "\u05ea\u05de\u05dc\u05d5\u05dc"
    },
    "recording_url": {
      "type": "string",
      "title": "\u05d4\u05e7\u05dc\u05d8\u05d4"
    }
  },
  "required": [
    "campaign_id",
    "client_id",
    "status"
  ]
}