{
  "name": "VapiWebhookEvents",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "title": "\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "client_id": {
      "type": "string",
      "title": "\u05dc\u05e7\u05d5\u05d7"
    },
    "call_id": {
      "type": "string",
      "title": "Vapi Call ID"
    },
    "event": {
      "type": "string",
      "enum": [
        "call.started",
        "call.ended",
        "call.failed"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "payload": {
      "type": "string",
      "title": "Payload (JSON)"
    },
    "phone_number": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "duration_seconds": {
      "type": "number",
      "title": "\u05de\u05e9\u05da (\u05e9\u05e0\u05d9\u05d5\u05ea)",
      "default": 0
    },
    "received_at": {
      "type": "string",
      "title": "\u05d4\u05ea\u05e7\u05d1\u05dc \u05d1\u05e9\u05e2\u05d4"
    }
  },
  "required": [
    "event"
  ]
}