    "monthly_used_minutes": {
      "type": "number",
      "title": "\u05d3\u05e7\u05d5\u05ea \u05e9\u05e0\u05d5\u05e6\u05dc\u05d5 \u05d4\u05d7\u05d5\u05d3\u05e9",
