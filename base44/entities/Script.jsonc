{
  "name": "Script",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05ea\u05e1\u05e8\u05d9\u05d8"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "language": {
      "type": "string",
      "enum": [
        "he",
        "ar"
      ],
      "default": "he",
      "title": "\u05e9\u05e4\u05d4"
    },
    "system_prompt": {
      "type": "string",
      "title": "System Prompt (\u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05dc-AI)"
    },
    "first_message": {
      "type": "string",
      "title": "\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active"
      ],
      "default": "draft",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "assigned_client_id": {
      "type": "string",
      "title": "\u05dc\u05e7\u05d5\u05d7 \u05de\u05d5\u05e7\u05e6\u05d4"
    },
    "vapi_assistant_id": {
      "type": "string",
      "title": "Vapi Assistant ID"
    },
    "max_call_duration": {
      "type": "number",
      "title": "\u05de\u05e9\u05da \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc\u05e9\u05d9\u05d7\u05d4 (\u05e9\u05e0\u05d9\u05d5\u05ea)",
      "default": 180
    }
  },
  "required": [
    "name"
  ]
}