{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7"
    },
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "script_id": {
      "type": "string",
      "title": "\u05ea\u05e1\u05e8\u05d9\u05d8"
    },
    "virtual_number_id": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d5\u05d9\u05e8\u05d8\u05d5\u05d0\u05dc\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed"
      ],
      "default": "draft",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "dialing_start": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4",
      "default": "09:00"
    },
    "dialing_end": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd",
      "default": "20:00"
    },
    "max_concurrent": {
      "type": "number",
      "title": "\u05e9\u05d9\u05d7\u05d5\u05ea \u05d1\u05de\u05e7\u05d1\u05d9\u05dc",
      "default": 5
    },
    "max_retries": {
      "type": "number",
      "title": "\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd",
      "default": 2
    },
    "total_contacts": {
      "type": "number",
      "title": "\u05e1\u05d4\"\u05db \u05d0\u05e0\u05e9\u05d9 \u05e7\u05e9\u05e8",
      "default": 0
    },
    "dialed_contacts": {
      "type": "number",
      "title": "\u05d7\u05d5\u05d9\u05d2\u05d5",
      "default": 0
    },
    "answered_contacts": {
      "type": "number",
      "title": "\u05e2\u05e0\u05d5",
      "default": 0
    }
  },
  "required": [
    "name",
    "client_id"
  ]
}