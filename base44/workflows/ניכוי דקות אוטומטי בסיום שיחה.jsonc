{
  "name": "\u05e0\u05d9\u05db\u05d5\u05d9 \u05d3\u05e7\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05d1\u05e1\u05d9\u05d5\u05dd \u05e9\u05d9\u05d7\u05d4",
  "description": "",
